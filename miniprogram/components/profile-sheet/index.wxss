.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.admin-entry-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx 26rpx;
  border-radius: 30rpx;
  margin-bottom: 28rpx;
  background: linear-gradient(135deg, #eef2ff 0%, #f5f3ff 100%);
  border: 1.5rpx solid rgba(99, 102, 241, 0.25);
  box-shadow: 0 10rpx 24rpx rgba(79, 70, 229, 0.1);
}

.admin-entry-super {
  background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
  border-color: rgba(217, 119, 6, 0.3);
  box-shadow: 0 10rpx 24rpx rgba(217, 119, 6, 0.14);
}

.admin-entry-left {
  flex: 1;
  min-width: 0;
}

.admin-entry-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  font-size: 20rpx;
  font-weight: 700;
  color: #4f46e5;
  margin-bottom: 8rpx;
}

.admin-entry-super .admin-entry-badge {
  color: #b45309;
}

.admin-entry-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.admin-entry-sub {
  display: block;
  font-size: 21rpx;
  color: #64748b;
  margin-top: 4rpx;
  line-height: 1.45;
}

.admin-entry-arrow {
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #4f46e5;
  flex-shrink: 0;
}

.admin-entry-super .admin-entry-arrow {
  color: #b45309;
}

.role-v-super {
  color: #b45309 !important;
}

.role-v-admin {
  color: #4f46e5 !important;
}

.avatar-picker-btn {
  position: relative;
  width: 152rpx !important;
  height: 152rpx !important;
  min-height: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
  border-radius: 999rpx !important;
  overflow: hidden;
  background: #f2f2f7 !important;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.14);
  line-height: 1 !important;
}

.avatar-large {
  width: 152rpx;
  height: 152rpx;
  border-radius: 999rpx;
  display: block;
}

.avatar-badge {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 122, 255, 0.8);
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 36rpx;
  text-align: center;
}

.preset-row {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.preset-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  border: 4rpx solid transparent;
  background: #f2f2f7;
}

.preset-avatar-active {
  border-color: #007aff;
  transform: scale(1.08);
}

.field-group {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  font-size: 23rpx;
  font-weight: 600;
  color: #64748b;
  margin-bottom: 10rpx;
}

.ios-input {
  width: 100%;
  height: 84rpx;
  background: #f2f2f7;
  border-radius: 24rpx;
  padding: 0 26rpx;
  font-size: 27rpx;
  color: #1d1d1f;
}

.info-box {
  background: #f2f2f7;
  border-radius: 26rpx;
  padding: 18rpx 26rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 24rpx;
}

.info-k {
  color: #64748b;
}

.info-v {
  color: #1d1d1f;
  font-weight: 600;
}

.logout-btn {
  padding: 0 36rpx;
  flex-shrink: 0;
}

.save-reset-btn {
  flex: 1 !important;
  width: auto !important;
  min-height: 0 !important;
  margin: 0 !important;
  line-height: 88rpx !important;
}

.info-row-action {
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid rgba(15, 23, 42, 0.06);
}

.info-left {
  flex: 1;
  min-width: 0;
}

.info-hint {
  display: block;
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bind-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-shrink: 0;
}

.bound-tag {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #ecfdf5;
  color: #15803d;
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.unbind-link {
  font-size: 21rpx;
  color: #94a3b8;
  padding: 6rpx 4rpx;
}

.bind-wx-btn {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #13cf6d 0%, #07c160 100%);
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 700;
  flex-shrink: 0;
  box-shadow: 0 6rpx 14rpx rgba(7, 193, 96, 0.24);
}

.bind-email-btn {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(0, 122, 255, 0.12);
  color: #007aff;
  font-size: 21rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.bind-email-panel {
  margin-top: 10rpx;
  margin-bottom: 10rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: #ffffff;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
}

.bind-input {
  width: 100%;
  height: 74rpx;
  background: #f2f2f7;
  border-radius: 18rpx;
  padding: 0 22rpx;
  font-size: 24rpx;
  color: #1d1d1f;
}

.bind-code-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.bind-code-input {
  flex: 1;
  letter-spacing: 4rpx;
}

.bind-send-btn {
  height: 74rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: rgba(0, 122, 255, 0.12);
  color: #007aff;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.bind-confirm-btn {
  margin-top: 14rpx;
  height: 74rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #1687ff 0%, #007aff 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bind-error-text {
  font-size: 22rpx;
  color: #ff3b30;
  padding: 8rpx 0;
}

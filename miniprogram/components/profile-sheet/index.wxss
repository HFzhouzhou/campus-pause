.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.avatar-picker-btn {
  position: relative;
  width: 148rpx !important;
  height: 148rpx !important;
  min-height: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
  border-radius: 999rpx !important;
  overflow: hidden;
  background: #f2f2f7 !important;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.12);
  line-height: 1 !important;
}

.avatar-large {
  width: 148rpx;
  height: 148rpx;
  border-radius: 999rpx;
  display: block;
}

.avatar-badge {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.5);
  color: #ffffff;
  font-size: 18rpx;
  line-height: 36rpx;
  text-align: center;
}

.preset-row {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.preset-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  border: 4rpx solid transparent;
  background: #f2f2f7;
}

.preset-avatar-active {
  border-color: #007aff;
  transform: scale(1.08);
}

.field-group {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  font-size: 23rpx;
  font-weight: 600;
  color: #64748b;
  margin-bottom: 10rpx;
}

.ios-input {
  width: 100%;
  height: 84rpx;
  background: #f2f2f7;
  border-radius: 24rpx;
  padding: 0 26rpx;
  font-size: 27rpx;
  color: #1d1d1f;
}

.info-box {
  background: #f2f2f7;
  border-radius: 26rpx;
  padding: 18rpx 26rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 24rpx;
}

.info-k {
  color: #64748b;
}

.info-v {
  color: #1d1d1f;
  font-weight: 600;
}

.logout-btn {
  padding: 0 36rpx;
  flex-shrink: 0;
}

.save-btn {
  flex: 1;
}

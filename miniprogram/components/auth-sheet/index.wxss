.badge-pill {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(0, 122, 255, 0.1);
  color: #007aff;
  font-size: 21rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.mode-segment {
  display: flex;
  background: #f2f2f7;
  border-radius: 28rpx;
  padding: 8rpx;
  margin-bottom: 32rpx;
}

.mode-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 22rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #64748b;
  transition: all 0.2s ease;
}

.mode-btn-active {
  background: #ffffff;
  color: #1d1d1f;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.08);
}

.auth-block {
  padding-bottom: 24rpx;
}

.wx-profile-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 30rpx;
}

.wx-avatar-btn {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  margin: 0;
  border-radius: 999rpx;
  overflow: hidden;
  background: #f2f2f7;
  flex-shrink: 0;
}

.wx-avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 999rpx;
}

.wx-avatar-tag {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  color: #ffffff;
  font-size: 18rpx;
  line-height: 34rpx;
  text-align: center;
}

.wx-nick-wrap {
  flex: 1;
  min-width: 0;
}

.field-group {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  font-size: 23rpx;
  font-weight: 600;
  color: #64748b;
  margin-bottom: 10rpx;
}

.ios-input {
  width: 100%;
  height: 84rpx;
  background: #f2f2f7;
  border-radius: 26rpx;
  padding: 0 26rpx;
  font-size: 28rpx;
  color: #1d1d1f;
}

.code-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.code-input {
  flex: 1;
  letter-spacing: 6rpx;
}

.send-code-btn {
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 28rpx;
  border-radius: 26rpx;
  background: rgba(0, 122, 255, 0.12);
  color: #007aff;
  font-size: 24rpx;
  font-weight: 600;
  margin: 0;
  flex-shrink: 0;
}

.wx-login-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 999rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 28rpx rgba(7, 193, 96, 0.25);
}

.full-btn {
  width: 100%;
  margin-top: 8rpx;
}

.error-text {
  color: #ff3b30;
  font-size: 24rpx;
  font-weight: 500;
  margin-bottom: 18rpx;
}

.auth-tip {
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 20rpx;
}

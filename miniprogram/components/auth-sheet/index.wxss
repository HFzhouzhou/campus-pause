.badge-pill {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(0, 122, 255, 0.1);
  color: #007aff;
  font-size: 21rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.mode-segment {
  display: flex;
  background: #f2f2f7;
  border-radius: 26rpx;
  padding: 8rpx;
  margin-bottom: 30rpx;
}

.mode-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #64748b;
}

.mode-btn-active {
  background: #ffffff;
  color: #1d1d1f;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.08);
}

.auth-block {
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.wx-profile-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 30rpx;
}

.wx-avatar-btn {
  position: relative;
  width: 124rpx !important;
  height: 124rpx !important;
  min-height: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
  border-radius: 999rpx !important;
  overflow: hidden;
  background: #f2f2f7 !important;
  flex-shrink: 0;
  line-height: 1 !important;
}

.wx-avatar-img {
  width: 124rpx;
  height: 124rpx;
  border-radius: 999rpx;
  display: block;
}

.wx-avatar-tag {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.48);
  color: #ffffff;
  font-size: 18rpx;
  line-height: 34rpx;
  text-align: center;
}

.wx-nick-wrap {
  flex: 1;
  min-width: 0;
}

.field-group {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  font-size: 23rpx;
  font-weight: 600;
  color: #64748b;
  margin-bottom: 10rpx;
}

.ios-input {
  width: 100%;
  height: 84rpx;
  background: #f2f2f7;
  border-radius: 24rpx;
  padding: 0 26rpx;
  font-size: 27rpx;
  color: #1d1d1f;
}

.code-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.code-input {
  flex: 1;
  letter-spacing: 6rpx;
}

.send-code-btn {
  height: 84rpx;
  padding: 0 28rpx;
  border-radius: 24rpx;
  background: rgba(0, 122, 255, 0.12);
  color: #007aff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.error-text {
  color: #ff3b30;
  font-size: 24rpx;
  font-weight: 500;
  margin-bottom: 18rpx;
}

.auth-tip {
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 22rpx;
}

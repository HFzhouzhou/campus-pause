<view wx:if="{{visible}}" class="sheet-mask" bindtap="onMaskTap">
  <view class="sheet-panel" catchtap="noop">
    <view class="sheet-handle-wrap"><view class="sheet-handle"></view></view>

    <view class="sheet-header">
      <view>
        <view class="badge-pill">✦ 校园暂停键通行证</view>
        <view class="sheet-title">登录 / 注册</view>
        <view class="sheet-subtitle">{{reason ? '登录后即可' + reason : '未注册自动创建账号，逛页面无需强制登录'}}</view>
      </view>
      <view class="sheet-close" bindtap="onClose">✕</view>
    </view>

    <scroll-view scroll-y class="sheet-body">
      <!-- 登录方式分段切换：微信一键授权 / 邮箱验证码 -->
      <view class="mode-segment">
        <view
          class="mode-btn {{mode === 'wechat' ? 'mode-btn-active' : ''}}"
          data-mode="wechat"
          bindtap="switchMode"
        >微信一键登录</view>
        <view
          class="mode-btn {{mode === 'email' ? 'mode-btn-active' : ''}}"
          data-mode="email"
          bindtap="switchMode"
        >邮箱验证码</view>
      </view>

      <!-- 模式 1：微信小程序原生头像+昵称授权一键登录 -->
      <view wx:if="{{mode === 'wechat'}}" class="auth-block">
        <view class="wx-profile-row">
          <button
            class="wx-avatar-btn"
            open-type="chooseAvatar"
            bindchooseavatar="onChooseAvatar"
          >
            <image class="wx-avatar-img" src="{{wxAvatarUrl}}" mode="aspectFill" />
            <view class="wx-avatar-tag">换头像</view>
          </button>
          <view class="wx-nick-wrap">
            <text class="field-label">微信昵称（点击可直接填入微信昵称）</text>
            <input
              type="nickname"
              class="ios-input"
              value="{{wxNickName}}"
              placeholder="点击获取微信昵称或输入"
              bindinput="onWxNickInput"
              bindblur="onWxNickInput"
            />
          </view>
        </view>

        <view wx:if="{{errorMsg}}" class="error-text">{{errorMsg}}</view>

        <button
          class="wx-login-btn"
          loading="{{submitting}}"
          disabled="{{submitting}}"
          bindtap="onWeChatLogin"
        >
          微信一键授权登录
        </button>
        <view class="auth-tip">支持直接同步微信头像与昵称，与 Web 端数据架构一致</view>
      </view>

      <!-- 模式 2：真实 163 邮箱验证码登录（与 Web 端同一套服务器数据库） -->
      <view wx:if="{{mode === 'email'}}" class="auth-block">
        <view class="field-group">
          <text class="field-label">邮箱地址</text>
          <input
            type="text"
            class="ios-input"
            value="{{email}}"
            placeholder="输入 QQ / 163 / 校园邮箱"
            bindinput="onEmailInput"
          />
        </view>

        <view class="field-group">
          <text class="field-label">6 位邮箱验证码</text>
          <view class="code-row">
            <input
              type="number"
              maxlength="6"
              class="ios-input code-input"
              value="{{code}}"
              placeholder="输入 6 位验证码"
              bindinput="onCodeInput"
            />
            <button
              class="send-code-btn"
              disabled="{{sending || countdown > 0 || !email}}"
              bindtap="onSendCode"
            >
              {{sending ? '发送中' : countdown > 0 ? countdown + 's' : '获取验证码'}}
            </button>
          </view>
        </view>

        <view class="field-group">
          <text class="field-label">显示昵称（选填）</text>
          <input
            type="nickname"
            class="ios-input"
            value="{{nickname}}"
            placeholder="留空自动生成，也可点此填入微信昵称"
            bindinput="onNickInput"
          />
        </view>

        <view wx:if="{{errorMsg}}" class="error-text">{{errorMsg}}</view>

        <button
          class="ios-btn-primary full-btn"
          loading="{{submitting}}"
          disabled="{{submitting || !email || code.length < 6}}"
          bindtap="onEmailLogin"
        >
          验证并登录
        </button>
      </view>
    </scroll-view>
  </view>
</view>

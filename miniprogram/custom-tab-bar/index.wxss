.dock-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 500;
  padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom));
  pointer-events: none;
  display: flex;
  justify-content: center;
}

.dock-capsule {
  pointer-events: auto;
  position: relative;
  width: 100%;
  max-width: 686rpx;
  padding: 10rpx;
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.88) 0%,
    rgba(255, 255, 255, 0.74) 52%,
    rgba(255, 255, 255, 0.84) 100%
  );
  backdrop-filter: blur(36px) saturate(210%);
  -webkit-backdrop-filter: blur(36px) saturate(210%);
  border: 1rpx solid rgba(255, 255, 255, 0.96);
  box-shadow:
    inset 0 2rpx 2rpx rgba(255, 255, 255, 1),
    0 18rpx 44rpx -10rpx rgba(15, 23, 42, 0.2),
    0 4rpx 14rpx rgba(15, 23, 42, 0.08);
}

.dock-specular {
  position: absolute;
  top: 2rpx;
  left: 56rpx;
  right: 56rpx;
  height: 2rpx;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.95),
    transparent
  );
  pointer-events: none;
}

.dock-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 14rpx 8rpx;
  border-radius: 48rpx;
  color: #64748b;
  transition: transform 0.16s ease, color 0.2s ease;
}

.dock-item:active {
  transform: scale(0.92);
}

.dock-item-active {
  color: #007aff;
}

.dock-lens {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 48rpx;
  background: linear-gradient(
    180deg,
    rgba(0, 122, 255, 0.14) 0%,
    rgba(0, 122, 255, 0.08) 100%
  );
  border: 1rpx solid rgba(0, 122, 255, 0.18);
  box-shadow: inset 0 2rpx 2rpx rgba(255, 255, 255, 0.85);
}

.dock-icon {
  position: relative;
  z-index: 2;
  font-size: 32rpx;
  line-height: 1.1;
}

.dock-label {
  position: relative;
  z-index: 2;
  font-size: 20rpx;
  margin-top: 4rpx;
  font-weight: 500;
}

.dock-item-active .dock-label {
  font-weight: 700;
}

.dock-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 500;
  padding: 0 32rpx calc(22rpx + env(safe-area-inset-bottom));
  pointer-events: none;
  display: flex;
  justify-content: center;
}

.dock-capsule {
  pointer-events: auto;
  position: relative;
  width: 100%;
  max-width: 686rpx;
  padding: 10rpx;
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.92) 0%,
    rgba(255, 255, 255, 0.78) 55%,
    rgba(255, 255, 255, 0.88) 100%
  );
  backdrop-filter: blur(36px) saturate(210%);
  -webkit-backdrop-filter: blur(36px) saturate(210%);
  border: 1rpx solid rgba(255, 255, 255, 0.98);
  box-shadow:
    inset 0 2rpx 2rpx rgba(255, 255, 255, 1),
    0 16rpx 40rpx -10rpx rgba(15, 23, 42, 0.2),
    0 4rpx 12rpx rgba(15, 23, 42, 0.06);
}

.dock-specular {
  position: absolute;
  top: 2rpx;
  left: 56rpx;
  right: 56rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #ffffff, transparent);
  pointer-events: none;
}

.dock-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 8rpx;
  border-radius: 48rpx;
  color: #8e8e93;
  transition: transform 0.14s ease, color 0.18s ease;
}

.dock-item:active {
  transform: scale(0.92);
}

.dock-item-active {
  color: #007aff;
}

.dock-lens {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 48rpx;
  background: linear-gradient(
    180deg,
    rgba(0, 122, 255, 0.13) 0%,
    rgba(0, 122, 255, 0.07) 100%
  );
  border: 1rpx solid rgba(0, 122, 255, 0.16);
}

.dock-icon-img {
  position: relative;
  z-index: 2;
  width: 42rpx;
  height: 42rpx;
}

.dock-label {
  position: relative;
  z-index: 2;
  font-size: 20rpx;
  margin-top: 6rpx;
  font-weight: 500;
}

.dock-item-active .dock-label {
  font-weight: 700;
}

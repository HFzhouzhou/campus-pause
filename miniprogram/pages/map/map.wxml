<view class="map-page">
  <map
    id="campusMap"
    class="campus-map"
    longitude="{{mapLng}}"
    latitude="{{mapLat}}"
    scale="{{mapScale}}"
    markers="{{markers}}"
    enable-satellite="{{isSatellite}}"
    show-location="{{true}}"
    enable-zoom="{{true}}"
    enable-scroll="{{true}}"
    bindmarkertap="onMarkerTap"
    bindcallouttap="onMarkerTap"
    bindregionchange="onRegionChange"
    bindtap="onMapTap"
  />

  <!-- 顶部 Apple Maps 液态玻璃 HUD -->
  <view class="top-hud" style="padding-top: {{menuTop}}px;">
    <view class="top-brand-row" style="height: {{menuHeight}}px; padding-right: {{menuRightSpace}}px;">
      <view class="liquid-dock campus-badge" hover-class="tap-active" bindtap="onBackToCampus">
        <view class="status-dot {{hasUserGps ? 'dot-green' : 'dot-blue'}}"></view>
        <text class="campus-badge-text">广外·五合校区</text>
      </view>

      <view wx:if="{{user}}" class="liquid-dock account-pill" hover-class="tap-active" bindtap="openProfile">
        <image class="account-avatar" src="{{user.avatarUrl}}" mode="aspectFill" />
        <text class="account-name">{{user.nickname}}</text>
      </view>
      <view wx:else class="liquid-dock account-pill-guest" hover-class="tap-active" bindtap="openAuthManual">
        <text>登录</text>
      </view>
    </view>

    <!-- 液态玻璃搜索框（使用 SF 风格 PNG 图标） -->
    <view class="search-wrap">
      <view class="liquid-dock search-bar">
        <image class="search-icon-img" src="/assets/icons/search.png" mode="aspectFit" />
        <input
          class="search-input"
          value="{{searchQuery}}"
          placeholder="搜索明德楼、图书馆、落日角落…"
          placeholder-style="color: #94A3B8;"
          bindinput="onSearchInput"
        />
        <view wx:if="{{searchQuery}}" class="search-clear" bindtap="clearSearch">✕</view>
      </view>

      <view wx:if="{{poiResults.length > 0}}" class="poi-dropdown liquid-dock">
        <view
          wx:for="{{poiResults}}"
          wx:key="id"
          class="poi-item"
          data-index="{{index}}"
          bindtap="onSelectPoi"
        >
          <view class="poi-dot"></view>
          <view class="poi-info">
            <text class="poi-name">{{item.name}}</text>
            <text class="poi-addr">{{item.address}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 分类筛选胶囊 -->
    <scroll-view scroll-x class="cat-scroll" show-scrollbar="{{false}}">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="cat-pill {{activeCategory === item.id ? 'cat-pill-active' : 'liquid-glass'}}"
        data-id="{{item.id}}"
        bindtap="onSelectCategory"
      >
        <text>{{item.emoji}} {{item.label}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 右侧 Apple Maps 风格液态玻璃控件（高清 SF 图标） -->
  <view class="right-controls">
    <view class="liquid-dock ctrl-btn {{isSatellite ? 'ctrl-active' : ''}}" hover-class="tap-active" bindtap="toggleSatellite">
      <image class="ctrl-icon-img" src="{{isSatellite ? '/assets/icons/layers-active.png' : '/assets/icons/layers.png'}}" mode="aspectFit" />
      <text class="ctrl-txt-sub {{isSatellite ? 'text-blue' : ''}}">{{isSatellite ? '卫星' : '标准'}}</text>
    </view>
    <view class="liquid-dock ctrl-group">
      <view class="ctrl-mini" hover-class="tap-active" bindtap="zoomIn">+</view>
      <view class="ctrl-divider"></view>
      <view class="ctrl-mini" hover-class="tap-active" bindtap="zoomOut">−</view>
    </view>
    <view class="liquid-dock ctrl-btn" hover-class="tap-active" bindtap="onLocateMe">
      <image class="ctrl-icon-img" src="/assets/icons/locate.png" mode="aspectFit" />
    </view>
    <view class="liquid-dock ctrl-btn" hover-class="tap-active" bindtap="onBackToCampus">
      <image class="ctrl-icon-img" src="/assets/icons/campus.png" mode="aspectFit" />
    </view>
  </view>

  <!-- 选点模式准星 -->
  <view wx:if="{{isPickMode}}" class="crosshair-overlay">
    <view class="liquid-dock crosshair-label">{{geoSuggestionName || '拖动地图对准你想标记的位置'}}</view>
    <view class="crosshair-ring">
      <view class="crosshair-core"></view>
    </view>
  </view>

  <!-- 底部联动卡片流 / 选点确认条 -->
  <view class="bottom-area">
    <block wx:if="{{isPickMode}}">
      <view class="pick-bar liquid-dock">
        <view class="pick-meta">
          <text class="pick-title">{{geoSuggestionName || '已锁定校园坐标'}}</text>
          <text class="pick-coord">{{pickCoordText}}</text>
        </view>
        <view class="pick-actions">
          <view class="ios-btn ios-btn-ghost flex-1" hover-class="tap-active" bindtap="cancelPickMode">取消</view>
          <view class="ios-btn ios-btn-primary flex-15" hover-class="tap-active" bindtap="confirmPickLocation">确认此位置</view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="fab-row">
        <view class="mark-fab" hover-class="tap-active" bindtap="onEnterPickMode">
          <text class="mark-fab-plus">+</text>
          <text>标记治愈点</text>
        </view>
      </view>

      <swiper
        wx:if="{{filteredSpots.length > 0}}"
        class="spot-swiper"
        current="{{currentCardIndex}}"
        previous-margin="28rpx"
        next-margin="28rpx"
        bindchange="onSwiperChange"
      >
        <swiper-item wx:for="{{filteredSpots}}" wx:key="id" class="spot-swiper-item">
          <view class="spot-card liquid-dock" data-id="{{item.id}}" bindtap="openSpotDetail">
            <view class="spot-top">
              <view class="spot-cover-wrap">
                <image class="spot-cover" src="{{item.coverUrl}}" mode="aspectFill" />
                <view class="spot-cat-tag">{{item.catEmoji}} {{item.catLabel}}</view>
              </view>
              <view class="spot-info">
                <view class="spot-head">
                  <text class="spot-name">{{item.name}}</text>
                  <view class="spot-rate-pill">★ {{item.ratingText}}</view>
                </view>
                <view class="spot-meta-row">
                  <text class="spot-dist">{{item.distanceText}}</text>
                  <view class="quiet-pill" style="background: {{item.quietBg}}; color: {{item.quietColor}};">
                    <view class="quiet-dot" style="background: {{item.quietDot}};"></view>
                    <text>{{item.quietLabel}}</text>
                  </view>
                </view>
                <text class="spot-desc">{{item.recommendation}}</text>
              </view>
            </view>

            <view class="spot-foot">
              <view
                class="like-pill {{item.likedByMe ? 'like-pill-active' : ''}}"
                hover-class="tap-active"
                data-id="{{item.id}}"
                catchtap="onToggleLike"
              >
                <text>{{item.likedByMe ? '♥' : '♡'}} {{item.likes}}</text>
              </view>
              <view class="go-pill" hover-class="tap-active" data-id="{{item.id}}" catchtap="openSpotDetail">
                <text>去这里 · 详情 ›</text>
              </view>
            </view>
          </view>
        </swiper-item>
      </swiper>

      <view wx:else class="empty-card liquid-dock">
        <text>该分类暂无点位，点上方「+ 标记治愈点」分享秘密角落</text>
      </view>
    </block>
  </view>

  <!-- 点位详情三段式 Sheet -->
  <view wx:if="{{detailSpot}}" class="sheet-mask" bindtap="closeSpotDetail">
    <view class="sheet-panel" catchtap="noop">
      <view class="sheet-handle-wrap"><view class="sheet-handle"></view></view>
      <view class="sheet-header">
        <view class="header-text-wrap">
          <view class="sheet-title">{{detailSpot.name}}</view>
          <view class="sheet-subtitle">{{detailSpot.catEmoji}} {{detailSpot.catLabel}} · 距你 {{detailSpot.distanceText}} · ★ {{detailSpot.ratingText}}</view>
        </view>
        <view class="sheet-close" hover-class="tap-active" bindtap="closeSpotDetail">✕</view>
      </view>

      <scroll-view scroll-y class="sheet-scroll">
        <view class="sheet-inner">
          <image class="detail-cover" src="{{detailSpot.coverUrl}}" mode="aspectFill" />
          <view class="detail-quote">“{{detailSpot.recommendation}}”</view>

          <view class="detail-section">
            <view class="section-head">
              <text class="section-title">一键更新此刻安静度</text>
              <text class="section-sub">{{detailSpot.quietUpdatedAt}}</text>
            </view>
            <view class="quiet-btn-row">
              <view
                class="quiet-btn {{detailSpot.quietStatus === 'very_quiet' ? 'quiet-btn-active' : ''}}"
                data-status="very_quiet"
                bindtap="onUpdateQuiet"
              >很安静</view>
              <view
                class="quiet-btn {{detailSpot.quietStatus === 'moderate' ? 'quiet-btn-active' : ''}}"
                data-status="moderate"
                bindtap="onUpdateQuiet"
              >人不多</view>
              <view
                class="quiet-btn {{detailSpot.quietStatus === 'crowded' ? 'quiet-btn-active' : ''}}"
                data-status="crowded"
                bindtap="onUpdateQuiet"
              >有点吵</view>
            </view>
          </view>

          <view class="detail-section">
            <view class="section-head">
              <text class="section-title">同学打卡 ({{detailSpot.reviews.length}})</text>
            </view>
            <view class="review-input-row">
              <input
                class="review-input"
                value="{{reviewDraft}}"
                placeholder="留下一句此刻的感受…"
                placeholder-style="color: #94A3B8;"
                bindinput="onReviewInput"
              />
              <view class="review-send" hover-class="tap-active" bindtap="onSubmitReview">发送</view>
            </view>
            <view wx:for="{{detailSpot.reviews}}" wx:key="id" class="review-item">
              <view class="review-meta">
                <text class="review-author">{{item.author}}</text>
                <text class="review-time">{{item.moodTag}} · {{item.createdAt}}</text>
              </view>
              <text class="review-content">{{item.content}}</text>
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="sheet-footer">
        <view class="ios-btn ios-btn-ghost flex-1" hover-class="tap-active" data-id="{{detailSpot.id}}" bindtap="onToggleLike">
          {{detailSpot.likedByMe ? '♥ 已赞' : '♡ 点赞'}} {{detailSpot.likes}}
        </view>
        <view class="ios-btn ios-btn-primary flex-15" hover-class="tap-active" bindtap="onOpenNativeNav">
          微信地图导航去这里
        </view>
      </view>
    </view>
  </view>

  <!-- UGC 标记新治愈点 Sheet -->
  <view wx:if="{{addModalVisible}}" class="sheet-mask" bindtap="closeAddModal">
    <view class="sheet-panel" catchtap="noop">
      <view class="sheet-handle-wrap"><view class="sheet-handle"></view></view>
      <view class="sheet-header">
        <view class="header-text-wrap">
          <view class="sheet-title">标记新的校园治愈点</view>
          <view class="sheet-subtitle">{{geoSuggestionAddress || pickCoordText}}</view>
        </view>
        <view class="sheet-close" hover-class="tap-active" bindtap="closeAddModal">✕</view>
      </view>

      <scroll-view scroll-y class="sheet-scroll">
        <view class="sheet-inner">
          <view class="ugc-photo-box" bindtap="onChooseSpotPhoto">
            <image class="ugc-photo-preview" src="{{ugcCoverUrl}}" mode="aspectFill" />
            <view class="ugc-photo-btn">拍照 / 从相册选图</view>
          </view>

          <scroll-view scroll-x class="preset-scroll" show-scrollbar="{{false}}">
            <view
              wx:for="{{presetPhotos}}"
              wx:key="id"
              class="preset-chip {{ugcCoverUrl === item.url ? 'preset-chip-active' : ''}}"
              data-url="{{item.url}}"
              bindtap="onSelectPresetPhoto"
            >{{item.label}}</view>
          </scroll-view>

          <view class="form-group">
            <text class="form-label">地点名称 *</text>
            <input class="form-input" value="{{ugcName}}" maxlength="28" placeholder="例如：明德楼西侧吹风连廊" placeholder-style="color: #94A3B8;" bindinput="onUgcName" />
          </view>

          <view class="form-group">
            <text class="form-label">治愈分类</text>
            <view class="tag-wrap">
              <view
                wx:for="{{selectableCategories}}"
                wx:key="id"
                class="tag-chip {{ugcCategory === item.id ? 'tag-chip-active' : ''}}"
                data-id="{{item.id}}"
                bindtap="onUgcCat"
              >{{item.emoji}} {{item.label}}</view>
            </view>
          </view>

          <view class="form-group">
            <text class="form-label">安静指数（{{ugcRating}} 星）</text>
            <view class="star-row">
              <text
                wx:for="{{[1,2,3,4,5]}}"
                wx:key="*this"
                class="star-btn {{item <= ugcRating ? 'star-on' : ''}}"
                data-star="{{item}}"
                bindtap="onUgcStar"
              >★</text>
            </view>
          </view>

          <view class="form-group">
            <text class="form-label">写一句安利理由 *</text>
            <textarea class="form-textarea" value="{{ugcReason}}" maxlength="120" placeholder="几点来最治愈？有没有风、插座或亲人小猫？" placeholder-style="color: #94A3B8;" bindinput="onUgcReason" />
          </view>
        </view>
      </scroll-view>

      <view class="sheet-footer">
        <view class="ios-btn ios-btn-ghost flex-1" hover-class="tap-active" bindtap="closeAddModal">取消</view>
        <view class="ios-btn ios-btn-primary flex-15" hover-class="tap-active" bindtap="onSubmitAddSpot">发布到治愈地图</view>
      </view>
    </view>
  </view>

  <auth-sheet visible="{{authVisible}}" reason="{{authReason}}" bind:close="closeAuth" bind:success="onAuthSuccess" />
  <profile-sheet visible="{{profileVisible}}" user="{{user}}" bind:close="closeProfile" bind:updated="onProfileUpdated" bind:logout="onLogout" />
</view>

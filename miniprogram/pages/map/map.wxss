.map-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #eceff4;
}

.campus-map {
  width: 100%;
  height: 100%;
}

.top-hud {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 40;
  padding-left: 24rpx;
  padding-right: 24rpx;
  pointer-events: none;
}

.top-brand-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 16rpx;
  pointer-events: auto;
}

.campus-badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
  animation: pulseLive 2.4s ease-in-out infinite;
}

.dot-green {
  background: #34c759;
  box-shadow: 0 0 10rpx rgba(52, 199, 89, 0.65);
}

.dot-blue {
  background: #007aff;
  box-shadow: 0 0 10rpx rgba(0, 122, 255, 0.55);
}

.campus-badge-text {
  font-size: 23rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.search-wrap {
  position: relative;
  margin-bottom: 14rpx;
  pointer-events: auto;
}

.search-bar {
  height: 82rpx;
  border-radius: 999rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.search-icon-img {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  opacity: 0.7;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1d1d1f;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #64748b;
}

.poi-dropdown {
  margin-top: 12rpx;
  border-radius: 30rpx;
  padding: 8rpx;
}

.poi-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 18rpx;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.06);
}

.poi-item:last-child {
  border-bottom: none;
}

.poi-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #007aff;
  flex-shrink: 0;
}

.poi-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.poi-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.poi-addr {
  font-size: 21rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.cat-scroll {
  width: 100%;
  white-space: nowrap;
  height: 74rpx;
  padding: 4rpx 0;
  pointer-events: auto;
}

.cat-pill {
  display: inline-block;
  height: 58rpx;
  line-height: 58rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: #334155;
  margin-right: 12rpx;
  white-space: nowrap;
  vertical-align: middle;
}

.cat-pill-active {
  background: linear-gradient(180deg, #1687ff 0%, #007aff 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(0, 122, 255, 0.28);
}

.right-controls {
  position: fixed;
  right: 24rpx;
  bottom: calc(572rpx + env(safe-area-inset-bottom));
  z-index: 35;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.ctrl-btn {
  width: 80rpx;
  height: 78rpx;
  border-radius: 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ctrl-active {
  border-color: rgba(0, 122, 255, 0.42);
}

.ctrl-icon-img {
  width: 34rpx;
  height: 34rpx;
}

.ctrl-txt-sub {
  font-size: 17rpx;
  font-weight: 600;
  color: #475569;
  margin-top: 4rpx;
}

.text-blue {
  color: #007aff;
}

.ctrl-group {
  width: 80rpx;
  border-radius: 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ctrl-mini {
  width: 80rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 500;
  color: #1d1d1f;
}

.ctrl-divider {
  width: 44rpx;
  height: 1rpx;
  background: rgba(15, 23, 42, 0.1);
}

.crosshair-overlay {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -62%);
  z-index: 30;
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
}

.crosshair-label {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-bottom: 14rpx;
  max-width: 480rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.crosshair-ring {
  width: 54rpx;
  height: 54rpx;
  border-radius: 999rpx;
  border: 4rpx solid #007aff;
  background: rgba(0, 122, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
}

.crosshair-core {
  width: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #007aff;
}

.bottom-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(158rpx + env(safe-area-inset-bottom));
  z-index: 35;
}

.fab-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 14rpx;
  padding: 0 28rpx 16rpx;
}

.admin-fab {
  display: inline-flex;
  align-items: center;
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(79, 70, 229, 0.3);
}

.admin-fab-super {
  background: linear-gradient(135deg, #d97706 0%, #b45309 100%);
  box-shadow: 0 12rpx 28rpx rgba(180, 83, 9, 0.32);
}

.crosshair-ring-edit {
  border-color: #d97706;
  background: rgba(217, 119, 6, 0.16);
}

.crosshair-core-edit {
  background: #d97706;
}

.spot-foot-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-admin-btn {
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(79, 70, 229, 0.12);
  color: #4f46e5;
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 700;
}

.detail-admin-bar {
  background: #f5f3ff;
  border: 1.5rpx solid rgba(99, 102, 241, 0.22);
  border-radius: 26rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 22rpx;
}

.detail-admin-hint {
  display: block;
  font-size: 21rpx;
  font-weight: 600;
  color: #4f46e5;
  margin-bottom: 12rpx;
}

.detail-admin-btns {
  display: flex;
  gap: 12rpx;
}

.review-admin-row {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(15, 23, 42, 0.05);
}

.rev-adm-link {
  font-size: 21rpx;
  font-weight: 600;
  color: #4f46e5;
}

.rev-adm-del {
  font-size: 21rpx;
  font-weight: 600;
  color: #ff3b30;
}

.coord-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.reposition-pill {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(0, 122, 255, 0.12);
  color: #007aff;
  font-size: 22rpx;
  font-weight: 700;
}

.coord-input-row {
  display: flex;
  gap: 14rpx;
}

.sheet-mask-top {
  z-index: 1050;
}

.mark-fab {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 76rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #2c2c2e 0%, #161618 100%);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.28);
}

.mark-fab-plus {
  font-size: 32rpx;
  line-height: 1;
}

.spot-swiper {
  height: 326rpx;
  width: 100%;
}

.spot-swiper-item {
  padding: 4rpx 10rpx;
}

.spot-card {
  height: 306rpx;
  border-radius: 40rpx;
  padding: 24rpx 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.spot-top {
  display: flex;
  gap: 20rpx;
}

.spot-cover-wrap {
  position: relative;
  width: 164rpx;
  height: 164rpx;
  border-radius: 28rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #e2e8f0;
  box-shadow: 0 6rpx 16rpx rgba(15, 23, 42, 0.1);
}

.spot-cover {
  width: 100%;
  height: 100%;
}

.spot-cat-tag {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  font-size: 18rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.spot-info {
  flex: 1;
  min-width: 0;
}

.spot-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.spot-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1d1d1f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.spot-rate-pill {
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  background: #fffbeb;
  font-size: 21rpx;
  font-weight: 700;
  color: #ff9500;
  flex-shrink: 0;
}

.spot-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.spot-dist {
  font-size: 21rpx;
  color: #64748b;
  font-weight: 600;
}

.quiet-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 600;
}

.quiet-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
}

.spot-desc {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 22rpx;
  color: #475569;
  line-height: 1.48;
  margin-top: 10rpx;
}

.spot-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(15, 23, 42, 0.06);
}

.like-pill {
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #f2f2f7;
  display: inline-flex;
  align-items: center;
  font-size: 23rpx;
  font-weight: 600;
  color: #475569;
}

.like-pill-active {
  background: #fff1f2;
  color: #ff3b30;
}

.go-pill {
  height: 56rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #1687ff 0%, #007aff 100%);
  color: #ffffff;
  display: inline-flex;
  align-items: center;
  font-size: 23rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(0, 122, 255, 0.26);
}

.empty-card {
  margin: 0 28rpx;
  padding: 32rpx;
  border-radius: 36rpx;
  text-align: center;
  font-size: 25rpx;
  color: #475569;
}

.pick-bar {
  margin: 0 28rpx;
  padding: 26rpx;
  border-radius: 38rpx;
}

.pick-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.pick-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1d1d1f;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pick-coord {
  font-size: 20rpx;
  color: #64748b;
}

.pick-actions {
  display: flex;
  gap: 16rpx;
}

.header-text-wrap {
  flex: 1;
  min-width: 0;
}

.detail-cover {
  width: 100%;
  height: 360rpx;
  border-radius: 28rpx;
  background: #e2e8f0;
  margin-bottom: 24rpx;
}

.detail-quote {
  background: #f2f2f7;
  border-radius: 26rpx;
  padding: 24rpx 28rpx;
  font-size: 26rpx;
  color: #1d1d1f;
  line-height: 1.6;
  margin-bottom: 26rpx;
}

.detail-section {
  margin-bottom: 28rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.section-sub {
  font-size: 21rpx;
  color: #94a3b8;
}

.quiet-btn-row {
  display: flex;
  gap: 14rpx;
}

.quiet-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 22rpx;
  background: #f2f2f7;
  color: #475569;
  font-size: 24rpx;
  font-weight: 600;
}

.quiet-btn-active {
  background: #007aff;
  color: #ffffff;
}

.review-input-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.review-input {
  flex: 1;
  height: 76rpx;
  background: #f2f2f7;
  border-radius: 999rpx;
  padding: 0 26rpx;
  font-size: 24rpx;
}

.review-send {
  height: 76rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: #007aff;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.review-item {
  background: #f8fafc;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 14rpx;
}

.review-meta {
  display: flex;
  justify-content: space-between;
  font-size: 21rpx;
  margin-bottom: 8rpx;
}

.review-author {
  font-weight: 600;
  color: #1d1d1f;
}

.review-time {
  color: #94a3b8;
}

.review-content {
  font-size: 24rpx;
  color: #475569;
  line-height: 1.5;
}

.flex-1 {
  flex: 1;
}

.flex-15 {
  flex: 1.5;
}

.ugc-photo-box {
  position: relative;
  height: 260rpx;
  border-radius: 26rpx;
  overflow: hidden;
  background: #e2e8f0;
  margin-bottom: 16rpx;
}

.ugc-photo-preview {
  width: 100%;
  height: 100%;
}

.ugc-photo-btn {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  font-size: 22rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.preset-scroll {
  width: 100%;
  height: 64rpx;
  white-space: nowrap;
  margin-bottom: 22rpx;
}

.preset-chip {
  display: inline-block;
  height: 54rpx;
  line-height: 54rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #f2f2f7;
  color: #475569;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 12rpx;
  vertical-align: middle;
}

.preset-chip-active {
  background: #007aff;
  color: #ffffff;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 23rpx;
  font-weight: 600;
  color: #64748b;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  height: 82rpx;
  background: #f2f2f7;
  border-radius: 24rpx;
  padding: 0 24rpx;
  font-size: 27rpx;
  color: #1d1d1f;
}

.form-textarea {
  width: 100%;
  height: 150rpx;
  background: #f2f2f7;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #1d1d1f;
}

.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-chip {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #f2f2f7;
  color: #475569;
  font-size: 23rpx;
  font-weight: 600;
}

.tag-chip-active {
  background: #007aff;
  color: #ffffff;
}

.star-row {
  display: flex;
  gap: 14rpx;
}

.star-btn {
  font-size: 48rpx;
  color: #e2e8f0;
}

.star-on {
  color: #ff9500;
}

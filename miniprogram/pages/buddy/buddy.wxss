.buddy-page {
  padding-left: 30rpx;
  padding-right: 30rpx;
}

.page-head-block {
  margin-bottom: 24rpx;
}

.header-kicker {
  display: block;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #94a3b8;
}

.header-title {
  display: block;
  font-size: 50rpx;
  font-weight: 800;
  color: #1d1d1f;
  margin-top: 4rpx;
  letter-spacing: -0.6rpx;
}

.header-sub {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.toolbar {
  margin-bottom: 26rpx;
}

.cat-scroll {
  display: flex;
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.cat-pill {
  display: inline-block;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #475569;
  font-size: 23rpx;
  font-weight: 600;
  margin-right: 14rpx;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.06);
}

.cat-pill-active {
  background: #1d1d1f;
  color: #ffffff;
}

.buddy-card {
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.buddy-card-joined {
  border: 2rpx solid rgba(0, 122, 255, 0.3);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.countdown-pill {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #fffbeb;
  color: #ff9500;
  font-size: 22rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.card-badges {
  display: flex;
  gap: 10rpx;
}

.silent-pill {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #faf5ff;
  color: #af52de;
  font-size: 20rpx;
  font-weight: 600;
}

.count-pill {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #f2f2f7;
  color: #475569;
  font-size: 21rpx;
  font-weight: 600;
}

.buddy-title {
  display: block;
  font-size: 31rpx;
  font-weight: 700;
  color: #1d1d1f;
  line-height: 1.35;
}

.buddy-note {
  display: block;
  font-size: 24rpx;
  color: #475569;
  line-height: 1.58;
  margin-top: 10rpx;
}

.buddy-loc {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
  font-size: 23rpx;
}

.loc-main {
  color: #1d1d1f;
  font-weight: 600;
}

.loc-host {
  color: #64748b;
}

.boundary-pill {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #ecfdf5;
  color: #15803d;
  font-size: 21rpx;
  font-weight: 600;
}

.card-foot {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f1f5f9;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.cipher-hint {
  font-size: 22rpx;
  color: #64748b;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.join-btn {
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background: #007aff;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.join-btn-joined {
  background: rgba(0, 122, 255, 0.12);
  color: #007aff;
}

.join-btn-disabled {
  background: #e2e8f0;
  color: #94a3b8;
}

.header-text-wrap {
  flex: 1;
  min-width: 0;
}

.joined-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #ecfdf5;
  color: #15803d;
  font-size: 20rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.wallet-card {
  border-radius: 32rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, #007aff 0%, #5856d6 100%);
  color: #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(0, 122, 255, 0.26);
  margin-bottom: 20rpx;
}

.wallet-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
  opacity: 0.92;
  margin-bottom: 14rpx;
}

.wallet-k {
  font-weight: 600;
}

.wallet-time {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  font-weight: 700;
}

.wallet-cipher {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 18rpx;
}

.wallet-foot {
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.22);
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  opacity: 0.95;
}

.cipher-rule {
  background: #f2f2f7;
  border-radius: 22rpx;
  padding: 14rpx 20rpx;
  text-align: center;
  font-size: 21rpx;
  color: #475569;
  margin-bottom: 22rpx;
}

.chat-list {
  padding-bottom: 12rpx;
}

.chat-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}

.chat-me {
  align-items: flex-end;
}

.chat-other {
  align-items: flex-start;
}

.chat-meta {
  font-size: 19rpx;
  color: #94a3b8;
  margin-bottom: 6rpx;
}

.chat-bubble {
  max-width: 82%;
  padding: 16rpx 24rpx;
  border-radius: 28rpx;
  font-size: 25rpx;
  line-height: 1.5;
}

.bubble-me {
  background: #007aff;
  color: #ffffff;
  border-bottom-right-radius: 8rpx;
}

.bubble-other {
  background: #f2f2f7;
  color: #1d1d1f;
  border-bottom-left-radius: 8rpx;
}

.cipher-footer {
  padding: 18rpx 30rpx calc(26rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f1f5f9;
  background: #ffffff;
  flex-shrink: 0;
}

.phrase-scroll {
  display: flex;
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.phrase-chip {
  display: inline-block;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #f2f2f7;
  color: #334155;
  font-size: 21rpx;
  font-weight: 500;
  margin-right: 12rpx;
}

.chat-input-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.chat-input {
  flex: 1;
  height: 76rpx;
  background: #f2f2f7;
  border-radius: 999rpx;
  padding: 0 26rpx;
  font-size: 25rpx;
}

.chat-send {
  height: 76rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: #007aff;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.leave-link {
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  padding: 8rpx 0;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 23rpx;
  font-weight: 600;
  color: #64748b;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  height: 82rpx;
  background: #f2f2f7;
  border-radius: 24rpx;
  padding: 0 24rpx;
  font-size: 27rpx;
  color: #1d1d1f;
}

.form-textarea {
  width: 100%;
  height: 140rpx;
  background: #f2f2f7;
  border-radius: 24rpx;
  padding: 18rpx 24rpx;
  font-size: 26rpx;
}

.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-chip {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #f2f2f7;
  color: #475569;
  font-size: 23rpx;
  font-weight: 600;
}

.tag-chip-active {
  background: #007aff;
  color: #ffffff;
}

.seg-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.seg-col {
  flex: 1;
}

.seg-box {
  display: flex;
  background: #f2f2f7;
  border-radius: 22rpx;
  padding: 6rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 16rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: #64748b;
}

.seg-active {
  background: #ffffff;
  color: #1d1d1f;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.08);
}

.silent-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f2f2f7;
  border-radius: 26rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.sw-title {
  display: block;
  font-size: 25rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.sw-sub {
  display: block;
  font-size: 20rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.flex-1 {
  flex: 1;
}

.flex-15 {
  flex: 1.5;
}

.buddy-page {
  padding-left: 30rpx;
  padding-right: 30rpx;
}

.page-head-block {
  margin-bottom: 24rpx;
}

.header-kicker {
  display: block;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #94a3b8;
}

.header-title {
  display: block;
  font-size: 50rpx;
  font-weight: 800;
  color: #1d1d1f;
  margin-top: 4rpx;
  letter-spacing: -0.6rpx;
}

.header-sub {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.toolbar {
  margin-bottom: 26rpx;
}

.cat-scroll {
  display: flex;
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.cat-pill {
  display: inline-block;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #475569;
  font-size: 23rpx;
  font-weight: 600;
  margin-right: 14rpx;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.06);
}

.cat-pill-active {
  background: #1d1d1f;
  color: #ffffff;
}

.buddy-card {
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.buddy-card-joined {
  border: 2rpx solid rgba(0, 122, 255, 0.3);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.countdown-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #fff8eb;
  border: 1rpx solid rgba(255, 149, 0, 0.2);
  color: #e67700;
  font-size: 22rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.countdown-expired {
  background: #f1f5f9;
  border-color: transparent;
  color: #94a3b8;
}

.live-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #ff9500;
  box-shadow: 0 0 0 4rpx rgba(255, 149, 0, 0.18);
  animation: pulseLive 1.8s ease-in-out infinite;
}

.card-badges {
  display: flex;
  gap: 10rpx;
}

.silent-pill {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #f5f3ff;
  color: #7c3aed;
  font-size: 20rpx;
  font-weight: 600;
}

.count-pill {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #f2f4f8;
  color: #475569;
  font-size: 21rpx;
  font-weight: 600;
}

.buddy-title-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.buddy-emoji {
  font-size: 32rpx;
  line-height: 1.3;
  flex-shrink: 0;
}

.buddy-title {
  display: block;
  font-size: 31rpx;
  font-weight: 700;
  color: #1d1d1f;
  line-height: 1.36;
  flex: 1;
}

.buddy-note {
  display: block;
  font-size: 24rpx;
  color: #475569;
  line-height: 1.6;
  margin-top: 10rpx;
}

.buddy-meta-strip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 14rpx 18rpx;
  border-radius: 24rpx;
  background: #f6f8fc;
}

.host-monogram {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #dbeafe 0%, #ede9fe 100%);
  color: #1d4ed8;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.buddy-loc {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
  flex: 1;
}

.loc-main {
  font-size: 24rpx;
  color: #1d1d1f;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loc-host {
  font-size: 20rpx;
  color: #64748b;
}

.boundary-pill {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #ecfdf5;
  color: #15803d;
  font-size: 21rpx;
  font-weight: 600;
}

.card-foot {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(15, 23, 42, 0.06);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.cipher-hint {
  font-size: 22rpx;
  color: #64748b;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cipher-hint-unlocked {
  color: #007aff;
  font-weight: 600;
}

.join-btn {
  padding: 15rpx 32rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #1687ff 0%, #007aff 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(0, 122, 255, 0.24);
}

.join-btn-joined {
  background: rgba(0, 122, 255, 0.12);
  color: #007aff;
  box-shadow: none;
}

.join-btn-disabled {
  background: #e2e8f0;
  color: #94a3b8;
  box-shadow: none;
}

.header-text-wrap {
  flex: 1;
  min-width: 0;
}

.joined-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #ecfdf5;
  color: #15803d;
  font-size: 20rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.wallet-card {
  position: relative;
  overflow: hidden;
  border-radius: 36rpx;
  padding: 30rpx 28rpx 24rpx;
  background: linear-gradient(135deg, #007aff 0%, #5856d6 60%, #7c3aed 100%);
  color: #ffffff;
  box-shadow: 0 18rpx 38rpx rgba(0, 122, 255, 0.28);
  margin-bottom: 22rpx;
}

.wallet-shine {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.26) 0%, transparent 72%);
  pointer-events: none;
}

.wallet-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 21rpx;
  opacity: 0.94;
  margin-bottom: 16rpx;
}

.wallet-k {
  font-weight: 700;
  letter-spacing: 1rpx;
}

.wallet-time {
  padding: 5rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.wallet-cipher {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
  margin-bottom: 14rpx;
}

.wallet-tear-wrap {
  position: relative;
  height: 28rpx;
  margin: 8rpx -28rpx 12rpx;
  display: flex;
  align-items: center;
}

.wallet-tear-line {
  flex: 1;
  margin: 0 24rpx;
  border-top: 2rpx dashed rgba(255, 255, 255, 0.42);
}

.wallet-notch {
  position: absolute;
  top: 2rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.wallet-notch-l {
  left: -12rpx;
}

.wallet-notch-r {
  right: -12rpx;
}

.wallet-foot {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  font-weight: 500;
  opacity: 0.96;
}

.cipher-rule {
  background: #f2f2f7;
  border-radius: 22rpx;
  padding: 14rpx 20rpx;
  text-align: center;
  font-size: 21rpx;
  color: #475569;
  margin-bottom: 22rpx;
}

.chat-list {
  padding-bottom: 12rpx;
}

.chat-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}

.chat-me {
  align-items: flex-end;
}

.chat-other {
  align-items: flex-start;
}

.chat-meta {
  font-size: 19rpx;
  color: #94a3b8;
  margin-bottom: 6rpx;
}

.chat-bubble {
  max-width: 82%;
  padding: 16rpx 24rpx;
  border-radius: 28rpx;
  font-size: 25rpx;
  line-height: 1.5;
}

.bubble-me {
  background: #007aff;
  color: #ffffff;
  border-bottom-right-radius: 8rpx;
}

.bubble-other {
  background: #f2f2f7;
  color: #1d1d1f;
  border-bottom-left-radius: 8rpx;
}

.cipher-footer {
  padding: 18rpx 30rpx calc(26rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f1f5f9;
  background: #ffffff;
  flex-shrink: 0;
}

.phrase-scroll {
  display: flex;
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.phrase-chip {
  display: inline-block;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #f2f2f7;
  color: #334155;
  font-size: 21rpx;
  font-weight: 500;
  margin-right: 12rpx;
}

.chat-input-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.chat-input {
  flex: 1;
  height: 76rpx;
  background: #f2f2f7;
  border-radius: 999rpx;
  padding: 0 26rpx;
  font-size: 25rpx;
}

.chat-send {
  height: 76rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: #007aff;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.leave-link {
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  padding: 8rpx 0;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 23rpx;
  font-weight: 600;
  color: #64748b;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  height: 82rpx;
  background: #f2f2f7;
  border-radius: 24rpx;
  padding: 0 24rpx;
  font-size: 27rpx;
  color: #1d1d1f;
}

.form-textarea {
  width: 100%;
  height: 140rpx;
  background: #f2f2f7;
  border-radius: 24rpx;
  padding: 18rpx 24rpx;
  font-size: 26rpx;
}

.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-chip {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #f2f2f7;
  color: #475569;
  font-size: 23rpx;
  font-weight: 600;
}

.tag-chip-active {
  background: #007aff;
  color: #ffffff;
}

.seg-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.seg-col {
  flex: 1;
}

.seg-box {
  display: flex;
  background: #f2f2f7;
  border-radius: 22rpx;
  padding: 6rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 16rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: #64748b;
}

.seg-active {
  background: #ffffff;
  color: #1d1d1f;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.08);
}

.silent-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f2f2f7;
  border-radius: 26rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.sw-title {
  display: block;
  font-size: 25rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.sw-sub {
  display: block;
  font-size: 20rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.flex-1 {
  flex: 1;
}

.flex-15 {
  flex: 1.5;
}

<view class="ios-canvas ms-page" style="padding-top: {{menuTop}}px;">
  <!-- 顶部与微信胶囊对齐的导航栏 -->
  <view class="ios-nav-row" style="height: {{menuHeight}}px; padding-right: {{menuRightSpace}}px;">
    <view wx:if="{{user}}" class="liquid-dock account-pill" hover-class="tap-active" bindtap="openProfile">
      <image class="account-avatar" src="{{user.avatarUrl}}" mode="aspectFill" />
      <text class="account-name">{{user.nickname}}</text>
      <text wx:if="{{user.shortRoleBadge}}" class="role-tag-mini {{user.isSuperAdmin ? 'role-tag-super' : 'role-tag-admin'}}">{{user.shortRoleBadge}}</text>
    </view>
    <view wx:else class="liquid-dock account-pill-guest" hover-class="tap-active" bindtap="openAuthManual">登录</view>

    <view
      wx:if="{{user && user.isAdmin}}"
      class="liquid-dock admin-nav-pill {{user.isSuperAdmin ? 'admin-nav-pill-super' : ''}}"
      hover-class="tap-active"
      bindtap="openAdminConsole"
    >
      <text>{{user.isSuperAdmin ? '👑 超管' : '🛡️ 管理'}}</text>
    </view>
  </view>

  <view class="page-head-block">
    <text class="header-kicker">MICRO-STEP · 10分钟微行动</text>
    <text class="header-title">微步拆解</text>
    <text class="header-sub">把压得喘不过气的大任务，切成 3 个 10 分钟小步骤</text>
  </view>

  <!-- 任务输入与高频场景库 -->
  <view class="ios-card input-card">
    <view class="scenario-tags">
      <view
        wx:for="{{quickScenarios}}"
        wx:key="*this"
        class="scenario-tag"
        hover-class="tap-active"
        data-text="{{item}}"
        bindtap="onTapScenario"
      >{{item}}</view>
    </view>

    <view class="input-row">
      <input
        class="ms-input"
        value="{{promptInput}}"
        placeholder="输入让你拖延的大事，如：后天考高数还没复习…"
        placeholder-style="color: #94A3B8;"
        confirm-type="done"
        bindinput="onPromptInput"
        bindconfirm="onGenerate"
      />
    </view>

    <view
      class="ios-btn ios-btn-primary {{(!promptInput || isStreaming) ? 'ios-btn-disabled' : ''}}"
      hover-class="tap-active"
      bindtap="onGenerate"
    >
      {{isStreaming ? '正在拆解微行动…' : '拆成 3 个 10 分钟微步骤'}}
    </view>
  </view>

  <!-- 实时流式思考/打字机拆解动画卡片 -->
  <view wx:if="{{isStreaming}}" class="ios-card stream-card">
    <view class="stream-head">
      <view class="stream-beacon"></view>
      <text class="stream-status">{{streamStage}}</text>
      <text class="stream-pct">{{streamProgress}}%</text>
    </view>
    <view class="stream-bar-track">
      <view class="stream-bar-fill" style="width: {{streamProgress}}%;"></view>
    </view>
    <view class="stream-box">
      <text class="stream-text" space="nbsp">{{streamPreview}}</text>
      <view class="stream-cursor"></view>
    </view>
  </view>

  <!-- 当前拆解结果 -->
  <view wx:if="{{!isStreaming && activePlan}}" class="plan-wrap">
    <view class="ios-card empathy-card {{progressPercent === 100 ? 'empathy-card-done' : ''}}">
      <view class="empathy-top">
        <view class="empathy-goal-wrap">
          <view class="empathy-dot {{progressPercent === 100 ? 'empathy-dot-done' : ''}}"></view>
          <text class="empathy-goal">{{activePlan.prompt}}</text>
        </view>
        <text class="empathy-progress {{progressPercent === 100 ? 'empathy-progress-done' : ''}}">
          {{progressPercent === 100 ? '全部达成 🎉' : completedCount + ' / ' + activePlan.steps.length + ' 已完成'}}
        </text>
      </view>
      <text class="empathy-note">“{{activePlan.empathyNote}}”</text>
      <view class="prog-row">
        <view class="prog-track">
          <view class="prog-fill" style="width: {{progressPercent}}%;"></view>
        </view>
        <text class="prog-pct">{{progressPercent}}%</text>
      </view>
    </view>

    <view
      wx:for="{{activePlan.steps}}"
      wx:key="id"
      class="ios-card step-card step-stagger-{{index % 3}} {{item.completed ? 'step-done' : ''}}"
    >
      <view class="step-row">
        <view
          class="step-check {{item.completed ? 'step-check-on' : ''}}"
          hover-class="tap-active"
          data-id="{{item.id}}"
          bindtap="onToggleStep"
        >
          <text>{{item.completed ? '✓' : ''}}</text>
        </view>
        <view class="step-body">
          <view class="step-head">
            <view class="step-title-group">
              <text class="step-num step-num-{{index % 3}}">0{{index + 1}}</text>
              <text class="step-title {{item.completed ? 'step-title-done' : ''}}">{{item.title}}</text>
            </view>
            <view class="step-min-pill">{{item.durationMinutes}} min</view>
          </view>
          <text class="step-detail">{{item.detail}}</text>

          <view class="step-actions">
            <view class="edit-link" hover-class="tap-active" data-id="{{item.id}}" bindtap="openEditStep">微调内容</view>
            <view class="focus-btn {{item.completed ? 'focus-btn-done' : ''}}" hover-class="tap-active" data-id="{{item.id}}" bindtap="openTimer">
              ▶ {{item.completed ? '再专注 10 分钟' : '开启 10 分钟专注'}}
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 最近拆解历史（禁用 enable-flex + 明确行高，彻底杜绝横向列表拉伸变形） -->
  <view wx:if="{{history.length > 1}}" class="history-wrap">
    <text class="history-label">最近拆解记录</text>
    <scroll-view scroll-x class="history-scroll" show-scrollbar="{{false}}">
      <view
        wx:for="{{history}}"
        wx:key="id"
        class="history-chip {{activePlan && activePlan.id === item.id ? 'history-chip-active' : ''}}"
        hover-class="tap-active"
        data-id="{{item.id}}"
        bindtap="onSelectHistory"
      >{{item.prompt}}</view>
    </scroll-view>
  </view>

  <view class="dock-spacer"></view>

  <!-- 10 分钟专注倒计时 Sheet -->
  <view wx:if="{{timerStep}}" class="sheet-mask" bindtap="closeTimer">
    <view class="sheet-panel" catchtap="noop">
      <view class="sheet-handle-wrap"><view class="sheet-handle"></view></view>
      <view class="sheet-header">
        <view class="header-text-wrap">
          <view class="sheet-title">10 分钟微行动专注舱</view>
          <view class="sheet-subtitle">{{timerStep.title}}</view>
        </view>
        <view class="sheet-close" hover-class="tap-active" bindtap="closeTimer">✕</view>
      </view>

      <view class="timer-body">
        <text class="timer-detail">{{timerStep.detail}}</text>

        <view class="timer-halo {{timerRunning && !timerDone ? 'timer-halo-pulse' : ''}} {{timerDone ? 'timer-halo-done' : ''}}">
          <view class="timer-circle {{timerDone ? 'timer-circle-done' : ''}}">
            <block wx:if="{{timerDone}}">
              <text class="done-icon">🎉</text>
              <text class="done-txt">微行动完成！</text>
              <text class="done-sub">你已战胜启动阻力</text>
            </block>
            <block wx:else>
              <text class="timer-clock">{{timerText}}</text>
              <text class="timer-state">{{timerRunning ? '只管推进这一小步' : '已暂停呼吸一下'}}</text>
            </block>
          </view>
        </view>

        <view wx:if="{{!timerDone}}" class="demo-speed" bindtap="onQuickDemo5s">
          演示快捷：切换为 5 秒极速倒计时体验庆祝
        </view>
      </view>

      <view class="sheet-footer">
        <block wx:if="{{timerDone}}">
          <view class="ios-btn ios-btn-primary flex-1" hover-class="tap-active" bindtap="closeTimer">收下掌控感，返回下一步</view>
        </block>
        <block wx:else>
          <view class="ios-btn ios-btn-ghost flex-1" hover-class="tap-active" bindtap="toggleTimerRun">{{timerRunning ? '暂停' : '继续'}}</view>
          <view class="ios-btn ios-btn-primary flex-15" hover-class="tap-active" bindtap="finishTimerNow">✓ 提前完成打钩</view>
        </block>
      </view>
    </view>
  </view>

  <!-- 自定义微调步骤 Sheet -->
  <view wx:if="{{editingStep}}" class="sheet-mask" bindtap="closeEditStep">
    <view class="sheet-panel" catchtap="noop">
      <view class="sheet-handle-wrap"><view class="sheet-handle"></view></view>
      <view class="sheet-header">
        <view class="header-text-wrap">
          <view class="sheet-title">微调这一小步</view>
          <view class="sheet-subtitle">改成更贴合你此刻节奏的 10 分钟行动</view>
        </view>
        <view class="sheet-close" hover-class="tap-active" bindtap="closeEditStep">✕</view>
      </view>
      <view class="edit-body">
        <text class="edit-label">步骤标题</text>
        <input class="edit-input" value="{{editTitle}}" bindinput="onEditTitle" />
        <text class="edit-label">行动细节</text>
        <textarea class="edit-textarea" value="{{editDetail}}" bindinput="onEditDetail" />
      </view>
      <view class="sheet-footer">
        <view class="ios-btn ios-btn-ghost flex-1" hover-class="tap-active" bindtap="closeEditStep">取消</view>
        <view class="ios-btn ios-btn-primary flex-15" hover-class="tap-active" bindtap="saveEditStep">保存微调</view>
      </view>
    </view>
  </view>

  <auth-sheet visible="{{authVisible}}" reason="{{authReason}}" bind:close="closeAuth" bind:success="onAuthSuccess" />
  <profile-sheet visible="{{profileVisible}}" user="{{user}}" bind:close="closeProfile" bind:updated="onProfileUpdated" bind:logout="onLogout" />
</view>

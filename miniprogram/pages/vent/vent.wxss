.vent-page {
  padding-left: 30rpx;
  padding-right: 30rpx;
}

.page-head-block {
  margin-bottom: 26rpx;
}

.header-kicker {
  display: block;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #94a3b8;
}

.header-title {
  display: block;
  font-size: 50rpx;
  font-weight: 800;
  color: #1d1d1f;
  margin-top: 4rpx;
  letter-spacing: -0.6rpx;
}

.header-sub {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.vent-card {
  padding: 28rpx;
  margin-bottom: 32rpx;
}

.quick-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.quick-tag {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #f2f2f7;
  color: #475569;
  font-size: 22rpx;
  font-weight: 500;
}

.vent-textarea {
  width: 100%;
  height: 196rpx;
  background: #f2f2f7;
  border-radius: 26rpx;
  padding: 24rpx;
  font-size: 27rpx;
  color: #1d1d1f;
  line-height: 1.58;
  margin-bottom: 22rpx;
}

.shout-btn {
  position: relative;
  border-radius: 26rpx;
  background: #f2f2f7;
  overflow: hidden;
  padding: 22rpx 26rpx;
  margin-bottom: 22rpx;
  transition: transform 0.15s ease, background 0.2s ease;
}

.shout-btn-active {
  background: #fffbeb;
  transform: scale(0.985);
}

.shout-fill {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(90deg, rgba(255, 149, 0, 0.25), rgba(175, 82, 222, 0.18));
}

.shout-inner {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.shout-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.shout-mic {
  width: 60rpx;
  height: 60rpx;
  border-radius: 999rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.08);
  flex-shrink: 0;
}

.mic-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 999rpx;
  background: #ff9500;
  transition: transform 0.2s ease, background 0.2s ease;
}

.mic-dot-on {
  transform: scale(1.25);
  background: #ff3b30;
}

.shout-title {
  display: block;
  font-size: 25rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.shout-sub {
  display: block;
  font-size: 20rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.wave-bars {
  display: flex;
  align-items: center;
  gap: 5rpx;
  height: 44rpx;
}

.wave-bar {
  width: 6rpx;
  border-radius: 999rpx;
  background: #cbd5e1;
  transition: height 0.08s ease, background 0.2s ease;
}

.wave-bar-live {
  background: #ff9500;
}

.care-card {
  border-radius: 38rpx;
  padding: 30rpx;
  margin-bottom: 32rpx;
  background: linear-gradient(135deg, #fffbeb 0%, #ffffff 55%, #ecfdf5 100%);
  border: 2rpx solid #fde68a;
  box-shadow: 0 16rpx 40rpx rgba(251, 191, 36, 0.16);
}

.care-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.care-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.care-sub {
  display: block;
  font-size: 22rpx;
  color: #b45309;
  margin-top: 4rpx;
}

.care-close {
  font-size: 26rpx;
  color: #94a3b8;
  padding: 4rpx 10rpx;
}

.care-body {
  display: block;
  font-size: 23rpx;
  color: #475569;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.care-green {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.care-green-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #15803d;
}

.care-green-sub {
  display: block;
  font-size: 20rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.care-book-btn {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #34c759;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
}

.care-phones {
  display: flex;
  gap: 16rpx;
}

.care-phone-item {
  flex: 1;
  background: #ffffff;
  border-radius: 22rpx;
  padding: 18rpx 20rpx;
}

.phone-name {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.phone-num {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #ff9500;
  margin-top: 4rpx;
}

.bubble-section {
  margin-top: 10rpx;
}

.bubble-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.bubble-sec-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.bubble-sec-sub {
  display: block;
  font-size: 21rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.no-comment-pill {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  color: #15803d;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.06);
}

/* 三色通透虹彩悬浮液态泡泡 */
.soap-bubble {
  position: relative;
  border-radius: 50rpx;
  padding: 34rpx 32rpx 28rpx;
  margin-bottom: 26rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.98);
  transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.2s ease;
  animation: iosFadeUp 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.soap-tone-lavender {
  background: radial-gradient(
    115% 95% at 16% 10%,
    rgba(255, 255, 255, 0.98) 0%,
    rgba(248, 246, 255, 0.88) 52%,
    rgba(237, 233, 254, 0.78) 100%
  );
  box-shadow:
    inset 0 6rpx 12rpx rgba(255, 255, 255, 1),
    inset 14rpx 0 28rpx rgba(167, 139, 250, 0.16),
    inset -14rpx 0 28rpx rgba(56, 189, 248, 0.14),
    0 16rpx 36rpx -12rpx rgba(109, 40, 217, 0.12);
}

.soap-tone-amber {
  background: radial-gradient(
    115% 95% at 16% 10%,
    rgba(255, 255, 255, 0.98) 0%,
    rgba(255, 251, 240, 0.9) 52%,
    rgba(254, 243, 199, 0.72) 100%
  );
  box-shadow:
    inset 0 6rpx 12rpx rgba(255, 255, 255, 1),
    inset 14rpx 0 28rpx rgba(251, 191, 36, 0.18),
    inset -14rpx 0 28rpx rgba(244, 114, 182, 0.12),
    0 16rpx 36rpx -12rpx rgba(217, 119, 6, 0.12);
}

.soap-tone-mint {
  background: radial-gradient(
    115% 95% at 16% 10%,
    rgba(255, 255, 255, 0.98) 0%,
    rgba(240, 253, 248, 0.9) 52%,
    rgba(209, 250, 229, 0.76) 100%
  );
  box-shadow:
    inset 0 6rpx 12rpx rgba(255, 255, 255, 1),
    inset 14rpx 0 28rpx rgba(52, 211, 153, 0.18),
    inset -14rpx 0 28rpx rgba(56, 189, 248, 0.14),
    0 16rpx 36rpx -12rpx rgba(5, 150, 105, 0.12);
}

.soap-bubble-charging {
  transform: scale(1.032);
  box-shadow:
    inset 0 6rpx 12rpx rgba(255, 255, 255, 1),
    0 0 38rpx rgba(0, 122, 255, 0.28);
}

.soap-bubble-burst {
  transform: scale(1.05);
}

.soap-shine {
  position: absolute;
  top: 16rpx;
  left: 34rpx;
  width: 190rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(255, 255, 255, 0));
  transform: rotate(-9deg);
  pointer-events: none;
}

.soap-rim-dot {
  position: absolute;
  top: 44rpx;
  left: 236rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  pointer-events: none;
}

.bubble-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.bubble-tag {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  font-size: 21rpx;
  font-weight: 600;
  color: #334155;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.05);
}

.bubble-time {
  font-size: 20rpx;
  color: #94a3b8;
}

.bubble-text {
  display: block;
  font-size: 27rpx;
  color: #1d1d1f;
  line-height: 1.68;
}

.charge-track {
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.06);
  margin: 22rpx 0 18rpx;
  overflow: hidden;
}

.charge-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #007aff, #34c759, #ff9500);
}

.bubble-foot {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hug-pill {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(15, 23, 42, 0.07);
  font-size: 22rpx;
  font-weight: 600;
  color: #334155;
}

.hug-pill-on {
  background: #007aff;
  color: #ffffff;
  border-color: #007aff;
  box-shadow: 0 6rpx 16rpx rgba(0, 122, 255, 0.25);
}

.emp-pill {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(15, 23, 42, 0.07);
  font-size: 22rpx;
  font-weight: 600;
  color: #475569;
}

.emp-pill-on {
  background: #fffbeb;
  color: #ff9500;
  border-color: #fde68a;
}

.vortex-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(10, 14, 26, 0.88);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.vortex-halo {
  position: absolute;
  width: 440rpx;
  height: 440rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(99, 102, 241, 0.35), transparent 70%);
  animation: vortexSpin 1.25s ease-in-out forwards;
}

.vortex-ring {
  width: 340rpx;
  height: 340rpx;
  border-radius: 999rpx;
  border: 6rpx solid rgba(167, 139, 250, 0.7);
  background: radial-gradient(circle, #000000 35%, rgba(99, 102, 241, 0.35) 70%, transparent 100%);
  animation: vortexSpin 1.2s ease-in-out forwards;
}

.vortex-card {
  position: absolute;
  width: 420rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  color: #1d1d1f;
  font-size: 24rpx;
  text-align: center;
  animation: cardSuck 1.15s cubic-bezier(0.55, 0.06, 0.68, 0.19) forwards;
}

.vortex-tip {
  margin-top: 48rpx;
  font-size: 24rpx;
  color: #e2e8f0;
}

@keyframes vortexSpin {
  0% { transform: scale(0.4) rotate(0deg); opacity: 0; }
  45% { transform: scale(1.1) rotate(240deg); opacity: 1; }
  100% { transform: scale(0.1) rotate(600deg); opacity: 0; }
}

@keyframes cardSuck {
  0% { transform: scale(1) rotate(0deg); opacity: 1; }
  40% { transform: scale(0.7) rotate(140deg); opacity: 0.9; }
  100% { transform: scale(0) rotate(720deg); opacity: 0; }
}

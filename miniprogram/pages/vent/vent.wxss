.vent-page {
  padding-left: 30rpx;
  padding-right: 30rpx;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 28rpx;
  padding-right: 170rpx;
}

.header-kicker {
  display: block;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #94a3b8;
}

.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: #1d1d1f;
  margin-top: 4rpx;
}

.header-sub {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.header-account {
  position: fixed;
  right: 28rpx;
  top: 176rpx;
  z-index: 30;
}

.vent-card {
  padding: 30rpx;
  margin-bottom: 32rpx;
}

.quick-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.quick-tag {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #f2f2f7;
  color: #475569;
  font-size: 22rpx;
  font-weight: 500;
}

.vent-textarea {
  width: 100%;
  height: 196rpx;
  background: #f2f2f7;
  border-radius: 28rpx;
  padding: 24rpx;
  font-size: 27rpx;
  color: #1d1d1f;
  line-height: 1.55;
  margin-bottom: 22rpx;
}

.shout-btn {
  position: relative;
  border-radius: 28rpx;
  background: #f2f2f7;
  overflow: hidden;
  padding: 22rpx 26rpx;
  margin-bottom: 22rpx;
  transition: transform 0.15s ease;
}

.shout-btn-active {
  background: #fffbeb;
  transform: scale(0.985);
}

.shout-fill {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(90deg, rgba(255, 149, 0, 0.24), rgba(175, 82, 222, 0.18));
}

.shout-inner {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.shout-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.shout-mic {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.08);
}

.shout-title {
  display: block;
  font-size: 25rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.shout-sub {
  display: block;
  font-size: 20rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.shout-wave {
  font-size: 24rpx;
  color: #ff9500;
  letter-spacing: 4rpx;
}

.shred-btn {
  width: 100%;
}

/* 暖光心理关怀兜底卡片 */
.care-card {
  border-radius: 40rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  background: linear-gradient(135deg, #fffbeb 0%, #ffffff 55%, #ecfdf5 100%);
  border: 2rpx solid #fde68a;
  box-shadow: 0 16rpx 40rpx rgba(251, 191, 36, 0.18);
}

.care-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.care-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.care-sub {
  display: block;
  font-size: 22rpx;
  color: #b45309;
  margin-top: 4rpx;
}

.care-close {
  font-size: 28rpx;
  color: #94a3b8;
  padding: 4rpx 10rpx;
}

.care-body {
  display: block;
  font-size: 23rpx;
  color: #475569;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.care-green {
  background: #ffffff;
  border-radius: 26rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.care-green-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #15803d;
}

.care-green-sub {
  display: block;
  font-size: 20rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.care-book-btn {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #34c759;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
}

.care-phones {
  display: flex;
  gap: 16rpx;
}

.care-phone-item {
  flex: 1;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 18rpx 20rpx;
}

.phone-name {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.phone-num {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #ff9500;
  margin-top: 4rpx;
}

/* 悬浮虹彩液态泡泡 */
.bubble-section {
  margin-top: 12rpx;
}

.bubble-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}

.bubble-sec-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.bubble-sec-sub {
  display: block;
  font-size: 21rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.no-comment-pill {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  color: #34c759;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.06);
}

.soap-bubble {
  position: relative;
  border-radius: 54rpx;
  padding: 34rpx 34rpx 28rpx;
  margin-bottom: 26rpx;
  overflow: hidden;
  background: radial-gradient(
    115% 95% at 18% 12%,
    rgba(255, 255, 255, 0.98) 0%,
    rgba(255, 255, 255, 0.78) 45%,
    rgba(240, 249, 255, 0.72) 76%,
    rgba(245, 243, 255, 0.85) 100%
  );
  border: 2rpx solid rgba(255, 255, 255, 0.98);
  box-shadow:
    inset 0 6rpx 12rpx rgba(255, 255, 255, 1),
    inset 16rpx 0 32rpx rgba(56, 189, 248, 0.14),
    inset -16rpx 0 32rpx rgba(167, 139, 250, 0.14),
    0 18rpx 38rpx -12rpx rgba(15, 23, 42, 0.12);
  transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
}

.soap-bubble-charging {
  transform: scale(1.03);
  box-shadow:
    inset 0 6rpx 12rpx rgba(255, 255, 255, 1),
    0 0 36rpx rgba(0, 122, 255, 0.24);
}

.soap-bubble-burst {
  transform: scale(1.05);
}

.soap-shine {
  position: absolute;
  top: 18rpx;
  left: 38rpx;
  width: 180rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0));
  transform: rotate(-10deg);
  pointer-events: none;
}

.bubble-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.bubble-tag {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  font-size: 21rpx;
  font-weight: 600;
  color: #334155;
}

.bubble-time {
  font-size: 20rpx;
  color: #94a3b8;
}

.bubble-text {
  display: block;
  font-size: 27rpx;
  color: #1d1d1f;
  line-height: 1.65;
}

.charge-track {
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.07);
  margin: 22rpx 0 18rpx;
  overflow: hidden;
}

.charge-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #007aff, #34c759, #ff9500);
}

.bubble-foot {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hug-pill {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  font-size: 22rpx;
  font-weight: 600;
  color: #334155;
}

.hug-pill-on {
  background: #007aff;
  color: #ffffff;
  border-color: #007aff;
}

.emp-pill {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  font-size: 22rpx;
  font-weight: 600;
  color: #475569;
}

.emp-pill-on {
  background: #fffbeb;
  color: #ff9500;
  border-color: #fde68a;
}

/* 黑洞粉碎全屏动效 */
.vortex-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 950;
  background: rgba(15, 23, 42, 0.86);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.vortex-ring {
  width: 360rpx;
  height: 360rpx;
  border-radius: 999rpx;
  border: 6rpx solid rgba(167, 139, 250, 0.6);
  background: radial-gradient(circle, #000000 35%, rgba(99, 102, 241, 0.35) 70%, transparent 100%);
  animation: vortexSpin 1.2s ease-in-out forwards;
}

.vortex-card {
  position: absolute;
  width: 420rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  color: #1d1d1f;
  font-size: 24rpx;
  text-align: center;
  animation: cardSuck 1.15s cubic-bezier(0.55, 0.06, 0.68, 0.19) forwards;
}

.vortex-tip {
  margin-top: 48rpx;
  font-size: 24rpx;
  color: #e2e8f0;
}

@keyframes vortexSpin {
  0% { transform: scale(0.4) rotate(0deg); opacity: 0; }
  45% { transform: scale(1.1) rotate(240deg); opacity: 1; }
  100% { transform: scale(0.1) rotate(600deg); opacity: 0; }
}

@keyframes cardSuck {
  0% { transform: scale(1) rotate(0deg); opacity: 1; }
  40% { transform: scale(0.7) rotate(140deg); opacity: 0.9; }
  100% { transform: scale(0) rotate(720deg); opacity: 0; }
}

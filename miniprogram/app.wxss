/* Apple iOS 26 Light Mode + Liquid Glass 全局样式系统 */
page {
  background-color: #f2f2f7;
  color: #1d1d1f;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text',
    'PingFang SC', 'Helvetica Neue', sans-serif;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view,
text,
scroll-view,
input,
textarea,
button {
  box-sizing: border-box;
}

button::after {
  border: none;
}

.tap-active {
  opacity: 0.78;
  transform: scale(0.97);
}

/* 温和明亮的 iOS 分组页面氛围底 */
.ios-canvas {
  min-height: 100vh;
  background:
    radial-gradient(68% 36% at 8% 0%, rgba(56, 189, 248, 0.13) 0%, transparent 68%),
    radial-gradient(64% 34% at 92% 6%, rgba(167, 139, 250, 0.12) 0%, transparent 66%),
    #f2f2f7;
}

/* 顶部与微信右上角胶囊对齐的原生感导航条 */
.ios-nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

/* 标准 iOS 卡片 */
.ios-card {
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
  border: 1rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 40rpx;
  box-shadow:
    0 2rpx 6rpx rgba(15, 23, 42, 0.04),
    0 14rpx 36rpx -12rpx rgba(15, 23, 42, 0.08);
}

/* 苹果浅色液态玻璃材质 */
.liquid-glass {
  background: linear-gradient(
    145deg,
    rgba(255, 255, 255, 0.9) 0%,
    rgba(255, 255, 255, 0.76) 55%,
    rgba(255, 255, 255, 0.86) 100%
  );
  backdrop-filter: blur(28px) saturate(195%);
  -webkit-backdrop-filter: blur(28px) saturate(195%);
  border: 1rpx solid rgba(255, 255, 255, 0.96);
  box-shadow:
    inset 0 2rpx 1rpx rgba(255, 255, 255, 1),
    0 10rpx 28rpx -8rpx rgba(15, 23, 42, 0.13);
}

.liquid-dock {
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.9) 0%,
    rgba(255, 255, 255, 0.78) 55%,
    rgba(255, 255, 255, 0.86) 100%
  );
  backdrop-filter: blur(36px) saturate(210%);
  -webkit-backdrop-filter: blur(36px) saturate(210%);
  border: 1rpx solid rgba(255, 255, 255, 0.98);
  box-shadow:
    inset 0 2rpx 2rpx rgba(255, 255, 255, 1),
    0 16rpx 40rpx -10rpx rgba(15, 23, 42, 0.18),
    0 4rpx 12rpx rgba(15, 23, 42, 0.06);
}

/* 顶部账号胶囊（严格匹配微信胶囊高度，永不遮挡标题或内容） */
.account-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  height: 64rpx;
  padding: 0 22rpx 0 8rpx;
  border-radius: 999rpx;
}

.account-pill-guest {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #007aff;
}

.account-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
  border: 2rpx solid #ffffff;
  background: #e5e7eb;
}

.account-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #1d1d1f;
  max-width: 150rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 纯 View 实现的 iOS 按钮（彻底规避微信 style:v2 <button> 默认宽度和样式冲突！） */
.ios-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  transition: transform 0.14s ease, opacity 0.14s ease;
}

.ios-btn-primary {
  background: #007aff;
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(0, 122, 255, 0.24);
}

.ios-btn-dark {
  background: #1d1d1f;
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.2);
}

.ios-btn-green {
  background: #07c160;
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(7, 193, 96, 0.24);
}

.ios-btn-ghost {
  background: #f2f2f7;
  color: #475569;
}

.ios-btn-danger {
  background: #fff1f2;
  color: #ff3b30;
}

.ios-btn-disabled {
  opacity: 0.38;
}

/* 通用三段式 iOS Bottom Sheet（配合隐藏 custom-tab-bar，100% 不遮挡不截断） */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(15, 23, 42, 0.38);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.sheet-panel {
  width: 100%;
  max-height: 86vh;
  background: #ffffff;
  border-top-left-radius: 44rpx;
  border-top-right-radius: 44rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 -16rpx 56rpx rgba(15, 23, 42, 0.16);
  animation: sheetSlideUp 0.26s cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes sheetSlideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.sheet-handle-wrap {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 6rpx;
  flex-shrink: 0;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #d1d5db;
}

.sheet-header {
  padding: 10rpx 36rpx 22rpx;
  border-bottom: 1rpx solid #f1f5f9;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  flex-shrink: 0;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1d1d1f;
  letter-spacing: -0.4rpx;
}

.sheet-subtitle {
  font-size: 23rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: #f2f2f7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #64748b;
  flex-shrink: 0;
}

.sheet-scroll {
  width: 100%;
  max-height: 58vh;
}

.sheet-inner {
  padding: 26rpx 36rpx 32rpx;
}

.sheet-footer {
  padding: 20rpx 36rpx calc(26rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f1f5f9;
  background: #ffffff;
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex-shrink: 0;
}

.dock-spacer {
  height: calc(184rpx + env(safe-area-inset-bottom));
}

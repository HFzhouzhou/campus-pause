/* Apple iOS 26 Light Mode + Liquid Glass 精修视觉系统 */
page {
  background-color: #f4f5f9;
  color: #1d1d1f;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text',
    'PingFang SC', 'Helvetica Neue', sans-serif;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view,
text,
scroll-view,
input,
textarea,
button {
  box-sizing: border-box;
}

button::after {
  border: none;
}

.tap-active {
  opacity: 0.82;
  transform: scale(0.965);
}

/* 苹果通透微光浅色渐变背景 */
.ios-canvas {
  min-height: 100vh;
  background:
    radial-gradient(74% 38% at 6% 0%, rgba(56, 189, 248, 0.16) 0%, transparent 66%),
    radial-gradient(66% 36% at 94% 4%, rgba(167, 139, 250, 0.15) 0%, transparent 64%),
    radial-gradient(60% 34% at 50% 96%, rgba(52, 211, 153, 0.1) 0%, transparent 66%),
    #f4f5f9;
}

/* 顶部与微信右上角胶囊对齐的原生感导航条 */
.ios-nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

/* 标准 iOS 陶瓷白通透卡片 */
.ios-card {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(26px) saturate(185%);
  -webkit-backdrop-filter: blur(26px) saturate(185%);
  border: 1.5rpx solid rgba(255, 255, 255, 0.98);
  border-radius: 40rpx;
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 1),
    0 4rpx 10rpx rgba(15, 23, 42, 0.03),
    0 18rpx 44rpx -14rpx rgba(15, 23, 42, 0.09);
  animation: iosFadeUp 0.36s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes iosFadeUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pulseLive {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.35);
    opacity: 0.55;
  }
}

/* 苹果浅色液态玻璃 HUD 材质 */
.liquid-glass {
  background: linear-gradient(
    145deg,
    rgba(255, 255, 255, 0.92) 0%,
    rgba(255, 255, 255, 0.78) 55%,
    rgba(255, 255, 255, 0.88) 100%
  );
  backdrop-filter: blur(30px) saturate(200%);
  -webkit-backdrop-filter: blur(30px) saturate(200%);
  border: 1.5rpx solid rgba(255, 255, 255, 0.96);
  box-shadow:
    inset 0 2rpx 1rpx rgba(255, 255, 255, 1),
    0 10rpx 30rpx -8rpx rgba(15, 23, 42, 0.13);
}

.liquid-dock {
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.94) 0%,
    rgba(255, 255, 255, 0.8) 55%,
    rgba(255, 255, 255, 0.9) 100%
  );
  backdrop-filter: blur(38px) saturate(215%);
  -webkit-backdrop-filter: blur(38px) saturate(215%);
  border: 1.5rpx solid rgba(255, 255, 255, 0.98);
  box-shadow:
    inset 0 2rpx 2rpx rgba(255, 255, 255, 1),
    0 18rpx 44rpx -10rpx rgba(15, 23, 42, 0.17),
    0 4rpx 14rpx rgba(15, 23, 42, 0.05);
}

/* 顶部账号胶囊（严格匹配微信胶囊高度） */
.account-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  height: 64rpx;
  padding: 0 22rpx 0 8rpx;
  border-radius: 999rpx;
}

.account-pill-guest {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #007aff;
}

.account-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
  border: 2rpx solid #ffffff;
  background: #e5e7eb;
}

.account-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #1d1d1f;
  max-width: 156rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 纯 View 实现的 iOS 按钮 */
.ios-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 90rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  transition: transform 0.14s ease, opacity 0.14s ease;
}

.ios-btn-primary {
  background: linear-gradient(180deg, #1687ff 0%, #007aff 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(0, 122, 255, 0.28);
}

.ios-btn-dark {
  background: linear-gradient(180deg, #2c2c2e 0%, #161618 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(15, 23, 42, 0.22);
}

.ios-btn-green {
  background: linear-gradient(180deg, #13cf6d 0%, #07c160 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(7, 193, 96, 0.28);
}

.ios-btn-ghost {
  background: #f2f2f7;
  color: #475569;
}

.ios-btn-danger {
  background: #fff1f2;
  color: #ff3b30;
}

.ios-btn-disabled {
  opacity: 0.36;
}

/* 通用三段式 iOS Bottom Sheet */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(15, 23, 42, 0.38);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.sheet-panel {
  width: 100%;
  max-height: 86vh;
  background: #ffffff;
  border-top-left-radius: 48rpx;
  border-top-right-radius: 48rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 -16rpx 60rpx rgba(15, 23, 42, 0.18);
  animation: sheetSlideUp 0.28s cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes sheetSlideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.sheet-handle-wrap {
  display: flex;
  justify-content: center;
  padding: 18rpx 0 6rpx;
  flex-shrink: 0;
}

.sheet-handle {
  width: 76rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #d1d5db;
}

.sheet-header {
  padding: 10rpx 36rpx 22rpx;
  border-bottom: 1rpx solid #f1f5f9;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  flex-shrink: 0;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1d1d1f;
  letter-spacing: -0.4rpx;
}

.sheet-subtitle {
  font-size: 23rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: #f2f2f7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #64748b;
  flex-shrink: 0;
}

.sheet-scroll {
  width: 100%;
  max-height: 58vh;
}

.sheet-form {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  width: 100%;
  overflow: hidden;
}

.sheet-inner {
  padding: 26rpx 36rpx 32rpx;
}

.sheet-footer {
  padding: 20rpx 36rpx calc(26rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f1f5f9;
  background: #ffffff;
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex-shrink: 0;
}

.dock-spacer {
  height: calc(188rpx + env(safe-area-inset-bottom));
}

# ==============================================================================
# 校园暂停键 (Campus Pause) 环境变量配置示例
# 使用说明：复制本文件为 .env.local 并填入你的真实 Key（不填也可使用内置兜底模式完整演示！）
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 高德地图 JS API 2.0 配置 (https://console.amap.com/dev/key/app)
# ------------------------------------------------------------------------------
# 申请步骤：
#   1) 登录高德开放平台 -> 应用管理 -> 我的应用 -> 创建新应用
#   2) 添加 Key -> 服务平台选择「Web端(JS API)」
#   3) 复制生成的 Key 和 安全密钥(jscode) 到下方
# 注意：未配置时应用将自动降级为「交互式暗黑矢量校园地图」，零配置不白屏！
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=

# ------------------------------------------------------------------------------
# 2. 焦虑拆解 AI 大模型配置 (兼容 OpenAI Chat Completions 流式接口)
# ------------------------------------------------------------------------------
# 支持 DeepSeek / OpenAI / 通义千问 DashScope / Moonshot Kimi / 硅基流动 等
# 示例 (DeepSeek):
#   VITE_LLM_API_URL=https://api.deepseek.com/v1/chat/completions
#   VITE_LLM_API_KEY=sk-xxxxxxxx
#   VITE_LLM_MODEL=deepseek-chat
# 示例 (OpenAI):
#   VITE_LLM_API_URL=https://api.openai.com/v1/chat/completions
#   VITE_LLM_API_KEY=sk-xxxxxxxx
#   VITE_LLM_MODEL=gpt-4o-mini
# 注意：未配置时自动使用内置「智能关键词拆解 + 流式打字机」兜底引擎！
VITE_LLM_API_URL=
VITE_LLM_API_KEY=
VITE_LLM_MODEL=gpt-4o-mini

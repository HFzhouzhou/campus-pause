# ==============================================================================
# 校园暂停键 (Campus Pause) 环境变量配置示例
# 使用说明：复制本文件为 .env.local 并填入你的真实 Key
# ==============================================================================

# 1. 高德地图 Web 端 (JS API 2.0) 凭证
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=

# 预留：后续迁移微信小程序使用的 Key（当前 Web 端请勿调用此 Key）
VITE_AMAP_WX_KEY=

# 2. 邮箱验证码登录后端接口前缀（如 https://8.148.11.126/campus-pause-api）
# 未配置时自动启用内置 6 位体验验证码模式，可完整体验登录注册流程
VITE_AUTH_API_BASE=

# 3. 焦虑拆解 AI 大模型配置 (兼容 OpenAI Chat Completions 流式接口)
VITE_LLM_API_URL=
VITE_LLM_API_KEY=
VITE_LLM_MODEL=gpt-4o-mini
